{
  "name": "keystroke-overlay",
  "version": "1.2.1",
  "description": "Keystroke overlay for OBS: a tiny Windows tray app with a transparent overlay served on localhost.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nqble/keystroke-overlay.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "node tools/dev-debug.mjs",
    "devbuild": "node tools/devbuild.mjs",
    "build": "tauri build",
    "release": "node tools/release.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node tools/check-privacy.mjs",
    "check:privacy": "node tools/check-privacy.mjs",
    "check:style": "node tools/check-style.mjs",
    "test:lock": "node tests/lib/lock.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:install": "node tests/install/run.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
