{
  "name": "keystroke-overlay",
  "version": "1.3.0",
  "description": "Keystroke overlay for OBS: a tiny tray app (Windows; Linux X11 in progress) with a transparent overlay served on 127.0.0.1.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nqble/keystroke-overlay.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "node tools/dev-debug.mjs",
    "preview": "node tools/preview.mjs",
    "ui-sandbox": "node tools/ui-sandbox.mjs",
    "devbuild": "node tools/devbuild.mjs",
    "build": "tauri build",
    "release": "node tools/release.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && npm run test:ui && node tools/check-privacy.mjs",
    "test:ui": "node --test \"tests/ui/*.test.mjs\"",
    "check:privacy": "node tools/check-privacy.mjs",
    "check:style": "node tools/check-style.mjs",
    "check:types": "tsc -p jsconfig.json",
    "test:lock": "node tests/lib/lock.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:visual": "node tests/e2e/run.mjs --suite visual",
    "test:install": "node tests/install/run.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check:format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
