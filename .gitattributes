# Same line endings for everyone, whatever system they work on (see .editorconfig). This also keeps the format check in CI
# (which runs on Windows) from seeing Windows line endings.
* text=auto eol=lf

# PowerShell scripts are checked out with Windows line endings, as PowerShell expects.
*.ps1 text eol=crlf

# Never touch binary files.
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
