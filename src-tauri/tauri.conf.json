{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keystroke Overlay",
  "version": "1.4.0",
  "identifier": "com.keyoverlay.app",
  "build": { "frontendDist": "../ui/settings" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Jordan Phoutthavone",
    "copyright": "© 2026 Jordan Phoutthavone. MIT License.",
    "shortDescription": "Keystroke overlay for OBS",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2M0FBN0NENTQ5QzM5REQKUldUZE9aeFV6YWM2SnBCWHVJdzVpaVR3MFV3V09CMXdPWVhHN3IxUWoyeHR6aFFDUzVIZGUyQVEK",
      "endpoints": ["https://github.com/nqble/keystroke-overlay/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
